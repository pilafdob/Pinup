{
  "name": "pinup",
  "version": "1.0.2",
  "private": true,
  "description": "Pin files and folders in the Obsidian File Explorer.",
  "main": "main.js",
  "author": "pilafdob",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilafdob/Pinup.git"
  },
  "homepage": "https://github.com/pilafdob/Pinup#readme",
  "bugs": {
    "url": "https://github.com/pilafdob/Pinup/issues"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/*.test.mjs",
    "release:validate": "node scripts/validate-release.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "file-explorer",
    "pinning"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "monkey-around": "^3.0.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0"
  }
}
