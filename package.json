{
  "name": "pinup",
  "version": "0.1.0",
  "description": "Pin files and folders in the Obsidian File Explorer.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "file-explorer",
    "pinning"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0"
  }
}
